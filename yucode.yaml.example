# 将本文件复制为 yucode.yaml，再填写真实 api_key。不要提交真实密钥。
protocol: anthropic
model: claude-sonnet-4-6
base_url: https://api.anthropic.com
api_key: your-api-key
thinking:
  enabled: true

# 权限模式：default（未命中副作用请求确认）、acceptEdits（自动接受项目内编辑）、
# plan（只读）或 bypassPermissions（跳过未命中确认）。Shift+Tab 可在会话中切换。
permissions:
  mode: default

# MCP 工具 Server。用户级配置可放在 %APPDATA%\YuCode\yucode.yaml；
# 项目级 yucode.yaml 中同名 Server 会完整覆盖用户级声明。
# ${VAR} 会展开为启动 YuCode 的环境变量。每次 MCP 请求最长等待 30 秒。
mcp_servers:
  local_demo:
    transport: stdio
    command: python
    args: ["-m", "my_mcp_server"]
    env:
      DEMO_TOKEN: ${DEMO_TOKEN}
  remote_demo:
    transport: http
    url: https://example.com/mcp
    headers:
      Authorization: Bearer ${MCP_TOKEN}

# 远端 get_weather 工具会以 MCP__local_demo__get_weather 名称提供给 Agent。

# OpenAI 示例：
# protocol: openai
# model: gpt-5
# base_url: https://api.openai.com/v1
# api_key: your-api-key
